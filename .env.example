# Loomlight environment variables. Both are optional: the tool works with
# neither set. These are ordinary process environment variables -- Loomlight
# does not read .env files, so export them in your shell or pass them inline:
#
#     LOOMLIGHT_PASSPHRASE=loomlight-demo python3 loomlight.py lock draft.json --set

# Non-interactive passphrase for the locked write commands (lock, edit, colors,
# dimensions). Empty means "ask on a hidden terminal prompt".
LOOMLIGHT_PASSPHRASE=

# Set to 1 to force the plain-letter colour fallback instead of ANSI swatches.
NO_COLOR=
